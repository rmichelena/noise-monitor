[Unit]
Description=Noise Monitor - captura de audio/video y registro de eventos
Documentation=file:///home/roberto/noise-monitor/README.md
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roberto
Group=roberto
WorkingDirectory=/home/roberto/noise-monitor
ExecStart=/home/roberto/noise-monitor/venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/home/roberto/noise-monitor/__pycache__
Nice=5
Restart=always
RestartPreventExitStatus=78
RestartSec=10
# El dispositivo Coral y la cámara pueden tardar en enumerar tras un reinicio.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/video0 ] && exit 0; sleep 2; done; exit 0'
MemoryMax=5G
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
