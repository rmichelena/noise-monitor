# Ejemplo COMPLETO de config para modo simulado (Fase 0.5).
# Copiar a config.yaml: el loader NO fusiona archivos, así que este fichero
# lleva todas las secciones que lee el pipeline (audio, triggers, buffer,
# paths...). Antes solo traía video/tracker/debug y el pipeline moría al
# arrancar con KeyError 'audio'.
#
# 1. Descargar video: ./scripts/download_test_videos.sh "URL_YOUTUBE"
# 2. Extraer audio: ./scripts/extract_audio_from_video.sh data/test_videos/traffic_xxx.mp4
# 3. Descargar YAMNet: ./scripts/download_yamnet.sh
# 4. cp config.simulate.yaml.example config.yaml y ajustar `video.source`

# Parámetros de audio (en simulado se lee el WAV derivado del video)
audio:
  source: file                # "device" = micrófono real, "file" = WAV
  device_index: null
  file_path: data/test_videos/traffic_xxx_audio.wav
  sample_rate: 44100
  block_size: 4096            # ~93 ms por bloque
  calibration_offset: 0.0

# Umbrales de disparo (más bajos: el video de prueba no es la calle real)
triggers:
  peak_db: 70
  sustained_db: 60
  sustained_duration_ms: 1500
  correlation_db: 55
  cooldown_seconds: 5

video:
  source: "data/test_videos/traffic_xxx.mp4"  # ruta al video descargado
  resolution: [1920, 1080]
  framerate: 30
  inference_interval: 5
  detection_threshold: 0.5
  overlay_db: true
  overlay_every_frames: 5

# Buffer circular
buffer:
  audio_seconds: 10
  video_seconds: 10
  pre_event_seconds: 5
  post_event_seconds: 5

tracker:
  max_distance: 80          # px, distancia máxima entre centroides para match
  max_disappeared: 20       # inference frames sin ver antes de marcar como salido
  min_track_seconds: 2.0    # duración mínima para contar como pasaje real
  min_displacement: 60      # px, desplazamiento mínimo para filtrar estacionados
  max_track_seconds: 15

audio_classifier:
  model_path: models/yamnet.tflite
  labels_path: models/yamnet_labels.txt
  min_score: 0.3

debug:
  simulate: true
  loop_video: true
  audio_from_video: true   # usa traffic_xxx_audio.wav (derivado del path del video)

# Rutas (relativas al directorio del proyecto)
paths:
  database: data/events.db
  clips: data/clips
  reports: reports

# Dashboard web
web:
  host: 127.0.0.1
  port: 8000

# Sin referencias de pista el tracker no estima velocidad: en simulado se
# desactiva y los pasajes quedan con speed_kmh nulo.
speed:
  enabled: false

# Jerarquía de ruido para inferencia
noise_priority:
  truck: 1
  bus: 1
  motorcycle: 2
  car: 3
  bicycle: 4
  person: 5

# Retención de datos (scripts/purge.py)
retention:
  clip_days: 30
  levels_days: 400
